{
  "redirects": [
    {
      "source": "/",
      "has": [{"type": "header", "key": "x-vercel-ip-country", "value": "CN"}],
      "destination": "/zh",
      "permanent": false
    },
    {
      "source": "/",
      "destination": "/en",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}